    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/titillium-web": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.63.0",
