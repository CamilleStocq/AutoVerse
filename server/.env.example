# Copier en `.env` (facultatif : toutes les valeurs ont un défaut).

# Port de l'API (le frontend de dev la contacte via le proxy Vite).
PORT=8787

# Emplacement de la base SQLite (profils, wishlist, cache des sources).
# AUTOVERSE_DB=./data/runtime/autoverse.db

# User-Agent envoyé aux API publiques. Wikimedia demande un contact identifiable :
# remplacez par une adresse ou une URL qui vous appartient.
# HTTP_USER_AGENT=Autoverse/0.1 (https://votre-site.example; contact@votre-domaine.example)

# 1 = aucun appel réseau sortant (tests, démonstration hors ligne).
# AUTOVERSE_OFFLINE=0
