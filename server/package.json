{
  "name": "@autoverse/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "node --import ./test/env.ts --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "export:static": "node --env-file-if-exists=.env scripts/export-static.ts",
    "send:push": "node scripts/send-push.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.14",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3"
  }
}
